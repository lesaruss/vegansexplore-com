{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/directory/:slug",
      "destination": "/directory/listing"
    },
    {
      "source": "/pulse/:slug",
      "destination": "/api/pulse-article?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/cm",
      "destination": "/dashboard",
      "permanent": true
    },
    {
      "source": "/academy/2026-initiatives",
      "destination": "/dashboard/2026-initiatives",
      "permanent": true
    },
    {
      "source": "/academy/community-manager-handbook",
      "destination": "/dashboard/handbook",
      "permanent": true
    },
    {
      "source": "/passport/join",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/wp-admin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-admin/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-includes/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/xmlrpc.php",
      "destination": "/",
      "permanent": true
    }
  ]
}