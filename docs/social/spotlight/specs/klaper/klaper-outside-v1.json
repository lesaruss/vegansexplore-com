  {
   "t0": 0.0,
   "text": "Get outside every day.",
   "t1": 1.9
  },
  {
   "t0": 1.9,
   "text": "We need the sun on our faces.",
   "t1": 4.2
  },
  {
   "t0": 4.2,
   "text": "We need physical activity.",
   "t1": 5.38
  },
  {
   "t0": 5.38,
   "text": "Actually go to the park and get out in nature.",
   "t1": 8.58
  },
  {
   "t0": 8.58,
   "text": "We're suffering from nature deficit disorder.",
   "t1": 11.78
  },
  {
   "t0": 11.78,
   "text": "And combine it with a good brisk walk.",
   "t1": 13.98
  },
  {
   "t0": 13.98,
   "text": "That's basically all you need to do.",
   "t1": 15.28
  },
  {
   "t0": 15.28,
   "text": "Stay connected.",
   "t1": 16.18
  },
  {
   "t0": 16.18,
   "text": "It's so easy to cubicle yourself off even mentally.",
   "t1": 21.98
  },
  {
   "t0": 21.98,
   "text": "We are tribal creatures. We need each other.",
   "t1": 24.78
  },
  {
   "t0": 24.78,
   "text": "We need that connection.",
   "t1": 26.48
  }
